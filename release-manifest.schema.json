{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-context-atlas.invalid/schemas/release-manifest.schema.json",
  "title": "Secure Context Atlas release manifest",
  "type": "object",
  "required": ["schema_version", "project", "release", "hash_algorithm", "file_count", "files"],
  "properties": {
    "schema_version": {"type": "string"},
    "project": {"const": "Secure Context Atlas"},
    "release": {"const": "0.7.0"},
    "generated_at": {"type": "string"},
    "hash_algorithm": {"const": "sha256"},
    "file_count": {"type": "integer", "minimum": 1},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
