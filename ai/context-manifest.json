{
  "schema_version": "1.1",
  "release": "0.7.0",
  "format": "jsonl-or-markdown",
  "producer": "scripts/sctx.py",
  "pack_schema": "schemas/context-pack.schema.json",
  "default_maturity": ["curated", "production-ready", "tested"],
  "provenance": ["ai/index.json", "sources/lock.json"],
  "supported_commands": ["list", "show", "search", "pack", "validate", "export-sarif"],
  "selection_dimensions": ["stack", "surface", "family", "query", "maturity"],
  "safety": {
    "no_live_targets": true,
    "no_credentials": true,
    "no_payloads": true,
    "evidence_required_for_findings": true
  }
}
