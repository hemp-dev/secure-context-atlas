{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-context-atlas.invalid/schemas/advisory.schema.json",
  "title": "Normalized dynamic dependency advisory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "advisory_id", "package", "affected", "status", "severity", "published_at", "modified_at", "references", "provenance", "reachability"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.1"},
    "source": {"type": "string", "enum": ["osv", "github-advisory-database"]},
    "advisory_id": {"type": "string", "minLength": 2},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "name", "version"],
      "properties": {
        "ecosystem": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "affected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["range", "fixed_versions"],
      "properties": {
        "range": {"type": "string", "minLength": 1},
        "fixed_versions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "status": {"type": "string", "enum": ["affected", "fixed", "withdrawn", "unknown"]},
    "severity": {"type": "string", "enum": ["unknown", "low", "medium", "high", "critical"]},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "modified_at": {"type": ["string", "null"], "format": "date-time"},
    "references": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queried_at", "query", "source_url", "transport", "request_sha256", "response_sha256"],
      "properties": {
        "queried_at": {"type": "string", "format": "date-time"},
        "query": {"type": "string", "minLength": 3},
        "source_url": {"type": "string", "format": "uri"},
        "transport": {"type": "string", "enum": ["https", "fixture"]},
        "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "response_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "auth_mode": {"type": "string", "enum": ["anonymous", "token"]},
        "http_status": {"type": "integer", "minimum": 100, "maximum": 599}
      }
    },
    "reachability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"type": "string", "enum": ["unknown", "reachable", "not-reachable", "runtime-dependent"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
