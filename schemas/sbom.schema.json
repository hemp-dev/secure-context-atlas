{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-context-atlas.invalid/schemas/sbom.schema.json",
  "title": "SPDX 2.3 file-level release SBOM",
  "type": "object",
  "additionalProperties": false,
  "required": ["spdxVersion", "dataLicense", "SPDXID", "name", "documentNamespace", "creationInfo", "packages", "files", "relationships"],
  "properties": {
    "spdxVersion": {"type": "string", "const": "SPDX-2.3"},
    "dataLicense": {"type": "string", "const": "CC0-1.0"},
    "SPDXID": {"type": "string", "const": "SPDXRef-DOCUMENT"},
    "name": {"type": "string", "pattern": "^secure-context-atlas-0\\.7\\.0$"},
    "documentNamespace": {"type": "string", "format": "uri"},
    "creationInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "creators"],
      "properties": {
        "created": {"type": "string", "format": "date-time"},
        "creators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["SPDXID", "name", "versionInfo", "downloadLocation", "licenseDeclared"],
        "properties": {
          "SPDXID": {"type": "string", "pattern": "^SPDXRef-Package-[A-Za-z0-9.-]+$"},
          "name": {"type": "string", "minLength": 1},
          "versionInfo": {"type": "string", "minLength": 1},
          "downloadLocation": {"type": "string", "format": "uri"},
          "licenseDeclared": {"type": "string", "minLength": 1}
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["SPDXID", "fileName", "checksums", "licenseConcluded", "licenseInfoInFiles"],
        "properties": {
          "SPDXID": {"type": "string", "pattern": "^SPDXRef-File-[a-f0-9]{24}$"},
          "fileName": {"type": "string", "minLength": 1},
          "checksums": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "checksumValue"],
              "properties": {
                "algorithm": {"type": "string", "const": "SHA256"},
                "checksumValue": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }
          },
          "licenseConcluded": {"type": "string", "const": "NOASSERTION"},
          "licenseInfoInFiles": {"type": "array", "minItems": 1, "items": {"type": "string", "const": "NOASSERTION"}}
        }
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spdxElementId", "relationshipType", "relatedSpdxElement"],
        "properties": {
          "spdxElementId": {"type": "string"},
          "relationshipType": {"type": "string", "enum": ["DESCRIBES", "CONTAINS"]},
          "relatedSpdxElement": {"type": "string"}
        }
      }
    }
  }
}
