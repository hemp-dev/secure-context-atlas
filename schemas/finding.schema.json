{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-context-atlas.invalid/schemas/finding.schema.json",
  "title": "Secure Context Atlas evidence-backed finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id", "status", "title", "vulnerability_id", "canonical_cwe",
    "severity", "confidence", "evidence", "flow", "missing_control",
    "impact", "safe_verification", "remediation", "regression_test", "references"
  ],
  "properties": {
    "finding_id": {"type": "string", "pattern": "^finding\\.[a-z0-9][a-z0-9.-]*$"},
    "status": {"type": "string", "enum": ["confirmed", "probable", "needs-review", "not-applicable"]},
    "title": {"type": "string", "minLength": 5},
    "vulnerability_id": {"type": "string", "pattern": "^vuln\\.[a-z0-9][a-z0-9.-]*$"},
    "canonical_cwe": {"type": "string", "pattern": "^CWE-[0-9]+$"},
    "capec": {"type": "array", "items": {"type": "string", "pattern": "^CAPEC-[0-9]+$"}, "uniqueItems": true},
    "severity": {"type": "string", "enum": ["info", "low", "medium", "high", "critical"]},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "asset": {"type": "string"},
    "trust_boundary": {"type": "string"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "evidence.schema.json"}
    },
    "input_and_prerequisite": {"type": "string"},
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "transformations", "controls", "sink"],
      "properties": {
        "source": {"type": "string"},
        "transformations": {"type": "array", "items": {"type": "string"}},
        "controls": {"type": "array", "items": {"type": "string"}},
        "sink": {"type": "string"}
      }
    },
    "missing_control": {"type": "string", "minLength": 5},
    "exploitability": {"type": "string"},
    "impact": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "safe_verification": {"type": "string", "minLength": 10},
    "remediation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "regression_test": {"type": "string", "minLength": 5},
    "references": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewer": {"type": "string"},
        "reviewed_at": {"type": "string", "format": "date"},
        "model_run": {"type": "string"}
      }
    }
  }
}
