{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-ai-audit.invalid/schemas/source.schema.json",
  "title": "Source provenance record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "url", "purpose", "license", "version", "content_included", "content_excluded", "update_strategy"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 2},
    "url": {"type": "string", "format": "uri"},
    "repository": {"type": "string", "format": "uri"},
    "purpose": {"type": "string", "minLength": 10},
    "license": {"type": "string", "minLength": 2},
    "version": {"type": "string", "minLength": 1},
    "content_included": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "content_excluded": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "update_strategy": {"type": "string", "minLength": 5}
  }
}
