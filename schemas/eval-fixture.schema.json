{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-context-atlas.invalid/schemas/eval-fixture.schema.json",
  "title": "Synthetic Secure Context Atlas evaluation fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "vulnerability_id", "polarity", "expected_status", "expected_cwe", "query", "snippet", "evidence_required", "safe_boundary"],
  "properties": {
    "id": {"type": "string", "pattern": "^eval\\.[a-z0-9][a-z0-9.-]*\\.(positive|negative|ambiguous)$"},
    "vulnerability_id": {"type": "string", "pattern": "^vuln\\.[a-z0-9][a-z0-9.-]*$"},
    "polarity": {"type": "string", "enum": ["positive", "negative", "ambiguous"]},
    "expected_status": {"type": "string", "enum": ["candidate", "not-applicable", "needs-review"]},
    "expected_cwe": {"type": "string", "pattern": "^CWE-[0-9]+$"},
    "query": {"type": "string", "minLength": 8},
    "snippet": {"type": "string", "minLength": 8},
    "evidence_required": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "safe_boundary": {"type": "string", "minLength": 20}
  }
}
