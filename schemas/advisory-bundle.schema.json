{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-context-atlas.invalid/schemas/advisory-bundle.schema.json",
  "title": "Normalized dynamic advisory query result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "transport", "query", "queried_at", "request_sha256", "response_sha256", "advisories"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "source": {"type": "string", "enum": ["osv", "github-advisory-database"]},
    "transport": {"type": "string", "enum": ["https", "fixture"]},
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "package", "version"],
      "properties": {
        "ecosystem": {"type": "string", "minLength": 1},
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "queried_at": {"type": "string", "format": "date-time"},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "response_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "advisories": {
      "type": "array",
      "items": {"$ref": "advisory.schema.json"}
    }
  }
}
